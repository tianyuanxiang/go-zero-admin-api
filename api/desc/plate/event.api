syntax = "v1"

// 创建生产事件请求体（电镀过程中消耗的电量）
type CreateProductionEventReq {
	TankId        string  `json:"tankId"`                  // 槽体ID
	StartTime     string  `json:"startTime"`               // 生产开始时间（格式：2006-01-02 15:04:05）
	EndTime       string  `json:"endTime"`                 // 生产结束时间
	AmpHour       float64 `json:"ampHour"`                 // 实际电量（Ah），优先使用此值
	AreaDm2       float64 `json:"areaDm2,optional"`        // 工件面积（dm²），用于带液量计算
	WorkpieceType string  `json:"workpieceType,optional"`  // 工件类型：A平板件 B普通件 C复杂件（影响带液系数选择）
	Remark        string  `json:"remark,optional"`         // 备注
}

// 生产事件响应体
type ProductionEventItem {
	Id            int64   `json:"id"`            // 事件ID
	TankId        string  `json:"tankId"`        // 槽体ID
	StartTime     string  `json:"startTime"`     // 生产开始时间
	EndTime       string  `json:"endTime"`       // 生产结束时间
	AmpHour       float64 `json:"ampHour"`       // 电量（Ah）
	AreaDm2       float64 `json:"areaDm2"`       // 工件面积（dm²）
	WorkpieceType string  `json:"workpieceType"` // 工件类型
	IsProcessed   int     `json:"isProcessed"`   // 是否已被模型处理：1已处理 0待处理
	Remark        string  `json:"remark"`        // 备注
	CreatedAt     string  `json:"createdAt"`     // 记录创建时间
}

// 创建加药事件请求体（向槽中添加化学品）
type CreateDosingEventReq {
	TankId    string  `json:"tankId"`          // 槽体ID
	EventTime string  `json:"eventTime"`       // 加药时间（格式：2006-01-02 15:04:05）
	DrugType  string  `json:"drugType"`        // 药品类型：CrO3铬酸酐 H2SO4硫酸 Cr2O3三氧化二铬
	MassGram  float64 `json:"massGram"`        // 加药质量（克）
	Remark    string  `json:"remark,optional"` // 备注
}

// 加药事件响应体
type DosingEventItem {
	Id          int64   `json:"id"`          // 事件ID
	TankId      string  `json:"tankId"`      // 槽体ID
	EventTime   string  `json:"eventTime"`   // 加药时间
	DrugType    string  `json:"drugType"`    // 药品类型
	MassGram    float64 `json:"massGram"`    // 加药质量（克）
	IsProcessed int     `json:"isProcessed"` // 是否已处理
	Remark      string  `json:"remark"`      // 备注
	CreatedAt   string  `json:"createdAt"`   // 创建时间
}

// 创建补水事件请求体（向槽中补充纯水）
type CreateWaterEventReq {
	TankId      string  `json:"tankId"`          // 槽体ID
	EventTime   string  `json:"eventTime"`       // 补水时间（格式：2006-01-02 15:04:05）
	VolumeLiter float64 `json:"volumeLiter"`     // 补水量（升）
	Remark      string  `json:"remark,optional"` // 备注
}

// 补水事件响应体
type WaterEventItem {
	Id          int64   `json:"id"`          // 事件ID
	TankId      string  `json:"tankId"`      // 槽体ID
	EventTime   string  `json:"eventTime"`   // 补水时间
	VolumeLiter float64 `json:"volumeLiter"` // 补水量（升）
	IsProcessed int     `json:"isProcessed"` // 是否已处理
	Remark      string  `json:"remark"`      // 备注
	CreatedAt   string  `json:"createdAt"`   // 创建时间
}

// 事件列表查询请求（通用）
type ListEventReq {
	TankId    string `form:"tankId,optional"`     // 槽体ID过滤
	Page      int    `form:"page,default=1"`      // 页码
	PageSize  int    `form:"pageSize,default=20"` // 每页数量
	StartTime string `form:"startTime,optional"`  // 事件时间范围开始
	EndTime   string `form:"endTime,optional"`    // 事件时间范围结束
}

// 生产事件列表响应
type ListProductionEventResp {
	Total int64                 `json:"total"` // 总数
	List  []ProductionEventItem `json:"list"`  // 生产事件列表
}

// 加药事件列表响应
type ListDosingEventResp {
	Total int64             `json:"total"` // 总数
	List  []DosingEventItem `json:"list"`  // 加药事件列表
}

// 补水事件列表响应
type ListWaterEventResp {
	Total int64            `json:"total"` // 总数
	List  []WaterEventItem `json:"list"`  // 补水事件列表
}

// 触发模型计算请求体（手动触发未处理事件的计算）
type TriggerCalcReq {
	TankId string `json:"tankId"` // 槽体ID，留空则处理所有槽体
}

// 触发计算响应体
type TriggerCalcResp {
	ProcessedCount int `json:"processedCount"` // 本次处理的事件数量
}

@server (
	prefix: /api/plating
	group: plate/event
	middleware: AuthMiddleware,CasbinMiddleware
)
service plating-api {
	// 记录生产事件（电镀过程）
	@handler CreateProductionEventHandler
	post /event/production (CreateProductionEventReq)

	// 删除生产事件（仅可删除未处理的事件）
	@handler DeleteProductionEventHandler
	delete /event/production/:id

	// 查询生产事件列表
	@handler ListProductionEventHandler
	get /event/production (ListEventReq) returns (ListProductionEventResp)

	// 记录加药事件
	@handler CreateDosingEventHandler
	post /event/dosing (CreateDosingEventReq)

	// 删除加药事件（仅可删除未处理的事件）
	@handler DeleteDosingEventHandler
	delete /event/dosing/:id

	// 查询加药事件列表
	@handler ListDosingEventHandler
	get /event/dosing (ListEventReq) returns (ListDosingEventResp)

	// 记录补水事件
	@handler CreateWaterEventHandler
	post /event/water (CreateWaterEventReq)

	// 删除补水事件（仅可删除未处理的事件）
	@handler DeleteWaterEventHandler
	delete /event/water/:id

	// 查询补水事件列表
	@handler ListWaterEventHandler
	get /event/water (ListEventReq) returns (ListWaterEventResp)

	// 手动触发指定槽体的模型计算
	@handler TriggerCalcHandler
	post /event/trigger-calc (TriggerCalcReq) returns (TriggerCalcResp)
}
