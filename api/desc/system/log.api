syntax = "v1"

// 登录日志查询请求
type ListLoginLogReq {
	Page      int    `form:"page,default=1"`      // 页码
	PageSize  int    `form:"pageSize,default=20"` // 每页数量
	Username  string `form:"username,optional"`   // 用户名过滤
	Status    int    `form:"status,optional"`     // 状态：1成功 0失败
	StartTime string `form:"startTime,optional"`  // 开始时间（格式：2006-01-02 15:04:05）
	EndTime   string `form:"endTime,optional"`    // 结束时间
}

// 登录日志响应体
type LoginLogItem {
	Id        int64  `json:"id"`        // 日志ID
	Username  string `json:"username"`  // 用户名
	Ip        string `json:"ip"`        // 登录IP
	UserAgent string `json:"userAgent"` // 浏览器信息
	Status    int    `json:"status"`    // 登录状态：1成功 0失败
	Msg       string `json:"msg"`       // 提示消息
	LoginTime string `json:"loginTime"` // 登录时间
}

// 登录日志列表响应
type ListLoginLogResp {
	Total int64          `json:"total"` // 总数
	List  []LoginLogItem `json:"list"`  // 日志列表
}

// 操作日志查询请求
type ListOperLogReq {
	Page       int    `form:"page,default=1"`      // 页码
	PageSize   int    `form:"pageSize,default=20"` // 每页数量
	OperName   string `form:"operName,optional"`   // 操作人
	OperType   string `form:"operType,optional"`   // 操作类型
	Status     int    `form:"status,optional"`     // 状态：1成功 0失败
	StartTime  string `form:"startTime,optional"`  // 开始时间
	EndTime    string `form:"endTime,optional"`    // 结束时间
}

// 操作日志响应体
type OperLogItem {
	Id         int64  `json:"id"`         // 日志ID
	OperName   string `json:"operName"`   // 操作人名称
	OperType   string `json:"operType"`   // 操作类型（create/update/delete/query）
	Module     string `json:"module"`     // 操作模块
	Method     string `json:"method"`     // HTTP方法
	ReqUrl     string `json:"reqUrl"`     // 请求URL
	ReqParam   string `json:"reqParam"`   // 请求参数
	RespResult string `json:"respResult"` // 响应结果
	Status     int    `json:"status"`     // 状态：1成功 0失败
	Ip         string `json:"ip"`         // 操作IP
	OperTime   string `json:"operTime"`   // 操作时间
	Duration   int64  `json:"duration"`   // 耗时（毫秒）
}

// 操作日志列表响应
type ListOperLogResp {
	Total int64         `json:"total"` // 总数
	List  []OperLogItem `json:"list"`  // 日志列表
}

@server (
	prefix: /api/system
	group: system/log
	middleware: AuthMiddleware,CasbinMiddleware
)
service plating-api {
	// 分页查询登录日志
	@handler ListLoginLogHandler
	get /log/login (ListLoginLogReq) returns (ListLoginLogResp)

	// 清空登录日志
	@handler ClearLoginLogHandler
	delete /log/login/clear

	// 分页查询操作日志
	@handler ListOperLogHandler
	get /log/oper (ListOperLogReq) returns (ListOperLogResp)

	// 清空操作日志
	@handler ClearOperLogHandler
	delete /log/oper/clear
}
